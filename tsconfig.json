
{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "src/context"
  ],
  "exclude": [
    "node_modules",
    "archive",
    "src/app",
    "src/app-backup",
    "src/app-router-old",
    "src/components/animated-icon.web.tsx",
    "src/components/app-tabs.tsx",
    "src/components/app-tabs.web.tsx",
    "src/components/external-link.tsx",
    "src/constants/theme.ts"
  ]
}
